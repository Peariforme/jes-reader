{
  "name": "jes-reader",
  "displayName": "JES Reader",
  "description": "Navigable z/OS JES2 sysouts: failures in Problems, job steps in the Outline, messages colored by severity. Works with Zowe Explorer.",
  "version": "0.1.0",
  "publisher": "peariforme",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peariforme/jes-reader"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "z/OS",
    "mainframe",
    "JES2",
    "sysout",
    "spool",
    "Zowe"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:spool",
    "onLanguage:jesmsglg",
    "onLanguage:jesjcl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jes-sysout",
        "aliases": [
          "JES2 Sysout",
          "jes-sysout"
        ],
        "extensions": [
          ".sysout",
          ".joblog"
        ],
        "filenamePatterns": [
          "**/{JOB,TSU,STC}[0-9][0-9][0-9][0-9][0-9]/**/*.txt",
          "*.{JOB,TSU,STC}[0-9][0-9][0-9][0-9][0-9].*.*.[0-9]*"
        ],
        "firstLine": "^(1\\s+J E S 2  J O B  L O G|\\s+STMT NO\\. MESSAGE|\\s{8}1 //\\S+\\s+JOB\\b)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jes-sysout",
        "scopeName": "source.jes-sysout",
        "path": "./syntaxes/jes-sysout.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jesReader.openAsSysout",
        "title": "Open as Sysout",
        "category": "JES Reader"
      },
      {
        "command": "jesReader.restartServer",
        "title": "Restart Server",
        "category": "JES Reader"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jesReader.openAsSysout",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "JES Reader",
      "properties": {
        "jesReader.maxReturnCode": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 4095,
          "markdownDescription": "A step whose return code is above this value is reported as a warning."
        },
        "jesReader.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `jes-reader-lsp` binary. Empty: use the one bundled with the extension."
        },
        "jesReader.rulesFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "House rules file (`.jesreader.toml`). Empty: `.jesreader.toml` at the root of the workspace, then in your home directory. See the README for the format."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:server": "node scripts/build-server.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "~4.1.1",
    "ovsx": "^0.10.1",
    "typescript": "~5.6.3"
  },
  "homepage": "https://github.com/Peariforme/jes-reader#readme",
  "bugs": {
    "url": "https://github.com/Peariforme/jes-reader/issues"
  }
}
