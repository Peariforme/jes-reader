{
  "name": "jes-reader",
  "displayName": "JES Reader",
  "description": "Navigable z/OS JES2 sysouts: failures in Problems, job steps in the Outline, messages colored by severity. Works with Zowe Explorer.",
  "version": "0.1.0",
  "publisher": "peariforme",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peariforme/jes-reader"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "z/OS",
    "mainframe",
    "JES2",
    "sysout",
    "spool",
    "Zowe"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:spool",
    "onLanguage:jesmsglg",
    "onLanguage:jesjcl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jes-sysout",
        "aliases": [
          "JES2 Sysout",
          "jes-sysout"
        ],
        "extensions": [
          ".sysout",
          ".joblog"
        ],
        "filenamePatterns": [
          "**/{JOB,TSU,STC}[0-9][0-9][0-9][0-9][0-9]/**/*.txt",
          "*.{JOB,TSU,STC}[0-9][0-9][0-9][0-9][0-9].*.*.[0-9]*"
        ],
        "firstLine": "^(1\\s+J E S 2  J O B  L O G|\\s+STMT NO\\. MESSAGE|\\s{8}1 //\\S+\\s+JOB\\b)",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jes-sysout",
        "scopeName": "source.jes-sysout",
        "path": "./syntaxes/jes-sysout.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jesReader.openAsSysout",
        "title": "Open as Sysout",
        "category": "JES Reader"
      },
      {
        "command": "jesReader.restartServer",
        "title": "Restart Server",
        "category": "JES Reader"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jesReader.openAsSysout",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "JES Reader",
      "properties": {
        "jesReader.maxReturnCode": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 4095,
          "markdownDescription": "A step whose return code is above this value is reported as a warning."
        },
        "jesReader.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `jes-reader-lsp` binary. Empty: use the one bundled with the extension."
        },
        "jesReader.rulesFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "House rules file (`.jesreader.toml`). Empty: `.jesreader.toml` at the root of the workspace, then in your home directory. See the README for the format."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "jesError",
        "description": "Message ID reported as an error by JES Reader"
      },
      {
        "id": "jesWarning",
        "description": "Message ID reported as a warning by JES Reader"
      },
      {
        "id": "jesInformation",
        "description": "Message ID reported as information by JES Reader"
      },
      {
        "id": "jesMessage",
        "description": "Message ID that JES Reader does not report"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "jesError": [
            "token.error-token.message-id.jes-sysout"
          ],
          "jesWarning": [
            "token.warn-token.message-id.jes-sysout"
          ],
          "jesInformation": [
            "token.info-token.message-id.jes-sysout"
          ],
          "jesMessage": [
            "token.info-token.message-id.jes-sysout"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[jes-sysout]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[spool]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[jesmsglg]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[jesjcl]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "compile": "npm run typecheck && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "bundle": "node scripts/build.mjs --production",
    "build:server": "node scripts/build-server.mjs",
    "vscode:prepublish": "npm run typecheck && npm run bundle",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "~4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "ovsx": "^0.10.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.74.0",
    "vscode-languageclient": "^9.0.1"
  },
  "homepage": "https://github.com/Peariforme/jes-reader#readme",
  "bugs": {
    "url": "https://github.com/Peariforme/jes-reader/issues"
  }
}
